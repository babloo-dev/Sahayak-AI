# Local development placeholders only. Copy to .env and replace locally.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sahayak_ai
SPRING_DATASOURCE_USERNAME=replace_with_local_db_user
SPRING_DATASOURCE_PASSWORD=replace_with_local_db_password

# Vite exposes VITE_* values in the browser; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api

# Local Python FastAPI service address; no credentials configured yet.
ML_SERVICE_BASE_URL=http://localhost:8000
