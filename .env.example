# Local development placeholders only. Copy to .env and replace locally.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SAHAYAK_CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SAHAYAK_AUTH_DEV_TOKEN_ENABLED=true
SAHAYAK_DEV_CITIZEN_TOKEN=replace_with_long_random_local_token
SAHAYAK_DEV_CITIZEN_SUBJECT=local-citizen
SAHAYAK_DEV_RESCUE_TOKEN=replace_with_another_long_random_local_token
SAHAYAK_DEV_RESCUE_TEAM=Local response team
SAHAYAK_DEV_ADMIN_TOKEN=replace_with_a_third_long_random_local_token
SAHAYAK_DEV_ADMIN_SUBJECT=local-admin
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sahayak_ai
SPRING_DATASOURCE_USERNAME=replace_with_local_db_user
SPRING_DATASOURCE_PASSWORD=replace_with_local_db_password

# Vite exposes VITE_* values in the browser; never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api

# Local Python FastAPI service address; no credentials configured yet.
ML_SERVICE_BASE_URL=http://localhost:8000
